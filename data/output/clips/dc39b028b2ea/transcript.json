      "volume": 0.3352,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 16.028,
      "text": "놈하고는",
      "start": 15.728,
      "volume": 0.3975,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 16.348,
      "text": "이제",
      "start": 16.068,
      "volume": 0.2076,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 17.41,
      "text": "조금",
      "start": 17.169,
      "volume": 0.307,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 17.47,
      "text": "더",
      "start": 17.43,
      "volume": 0.5912,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 17.81,
      "text": "얽히고",
      "start": 17.53,
      "volume": 0.1526,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 18.03,
      "text": "싶지",
      "start": 17.83,
      "volume": 0.2409,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 18.35,
      "text": "않으신",
      "start": 18.05,
      "volume": 0.2736,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 18.911,
      "text": "겁니까?",
      "start": 18.431,
      "volume": 0.0647,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 85.432,
      "text": "그때로",
      "start": 85.132,
      "volume": 0.4367,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 87.972,
      "text": "살아가거라",
      "start": 85.472,
      "volume": 0.1476,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 88.353,
      "text": "나도",
      "start": 88.053,
      "volume": 0.6894,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 88.673,
      "text": "내",
      "start": 88.573,
      "volume": 0.6149,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 89.213,
      "text": "딸도",
      "start": 88.773,
      "volume": 0.4983,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 89.613,
      "text": "그러지",
      "start": 89.293,
      "volume": 0.387,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 90.833,
      "text": "못하였으나",
      "start": 89.653,
      "volume": 0.2743,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 91.753,
      "text": "너만은",
      "start": 91.393,
      "volume": 0.5978,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 93.134,
      "text": "반드시",
      "start": 92.694,
      "volume": 0.4546,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 93.674,
      "text": "그러하기를",
      "start": 93.174,
      "volume": 0.4303,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 94.014,
      "text": "바란다",
      "start": 93.734,
      "volume": 0.3227,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 96.734,
      "text": "행복하게",
      "start": 96.234,
      "volume": 0.4531,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 97.255,
      "text": "살아라",
      "start": 96.774,
      "volume": 0.4016,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 98.855,
      "text": "꼭",
      "start": 98.815,
      "volume": 0.7616,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 99.555,
      "text": "그래야",
      "start": 99.135,
      "volume": 0.415,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 113.158,
      "text": "한다",
      "start": 113.118,
      "volume": 0.2141,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 113.95,
      "text": "집을",
      "start": 113.65,
      "volume": 0.4546,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 114.451,
      "text": "나가려던",
      "start": 113.99,
      "volume": 0.4753,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 114.591,
      "text": "그",
      "start": 114.511,
      "volume": 0.2926,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 114.771,
      "text": "순간",
      "start": 114.611,
      "volume": 0.4893,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 115.851,
      "text": "그",
      "start": 114.851,
      "volume": 0.3375,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 116.512,
      "text": "사람이",
      "start": 116.132,
      "volume": 0.4272,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 117.172,
      "text": "말했다",
      "start": 116.552,
      "volume": 0.3804,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 119.194,
      "text": "봄이",
      "start": 119.034,
      "volume": 0.554,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 119.734,
      "text": "오면",
      "start": 119.234,
      "volume": 0.3276,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 122.075,
      "text": "서희와",
      "start": 121.515,
      "volume": 0.4638,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 122.696,
      "text": "경성에",
      "start": 122.156,
      "volume": 0.3418,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 123.376,
      "text": "가서",
      "start": 122.736,
      "volume": 0.29,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 125.378,
      "text": "카스테라를",
      "start": 124.537,
      "volume": 0.3656,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 126.058,
      "text": "먹읍시다",
      "start": 125.638,
      "volume": 0.4333,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 132.702,
      "text": "지은세,",
      "start": 132.002,
      "volume": 0.8014,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 133.523,
      "text": "지은세",
      "start": 133.083,
      "volume": 0.7304,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 134.564,
      "text": "유키의",
      "start": 133.623,
      "volume": 0.7203,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 135.324,
      "text": "곧",
      "start": 135.184,
      "volume": 0.7799,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 136.665,
      "text": "출발합니다",
      "start": 135.344,
      "volume": 0.638,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 191.887,
      "text": "어,",
      "start": 190.887,
      "volume": 0.4069,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 198.631,
      "text": "희대호",
      "start": 197.131,
      "volume": 0.041,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 203.852,
      "text": "상,",
      "start": 203.642,
      "volume": 0.2323,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 205.071,
      "text": "안녕하세요.",
      "start": 204.33,
      "volume": 0.366,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 206.491,
      "text": "늦은",
      "start": 206.311,
      "volume": 0.5617,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 206.651,
      "text": "밤",
      "start": 206.511,
      "volume": 0.6475,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 207.231,
      "text": "죄송합니다.",
      "start": 206.691,
      "volume": 0.3483,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 208.551,
      "text": "오늘",
      "start": 208.391,
      "volume": 0.5782,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 208.932,
      "text": "연회장",
      "start": 208.591,
      "volume": 0.683,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 209.252,
      "text": "사건",
      "start": 208.952,
      "volume": 0.4281,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 209.492,
      "text": "때문에",
      "start": 209.292,
      "volume": 0.4694,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 210.032,
      "text": "경찰들이",
      "start": 209.512,
      "volume": 0.4198,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 210.512,
      "text": "부상자를",
      "start": 210.072,
      "volume": 0.5194,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 210.892,
      "text": "확인하고",
      "start": 210.552,
      "volume": 0.3607,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 212.232,
      "text": "있습니다.",
      "start": 210.912,
      "volume": 0.0399,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 212.512,
      "text": "다친",
      "start": 212.292,
      "volume": 0.4516,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 212.813,
      "text": "곳은",
      "start": 212.552,
      "volume": 0.3145,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 216.561,
      "text": "없으십니까?",
      "start": 214.113,
      "volume": 0.1539,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 217.594,
      "text": "여보",
      "start": 217.234,
      "volume": 0.559,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 218.154,
      "text": "무슨",
      "start": 217.794,
      "volume": 0.4883,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 218.694,
      "text": "일이에요?",
      "start": 218.194,
      "volume": 0.4347,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 221.395,
      "text": "희대호사,",
      "start": 220.334,
      "volume": 0.2626,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 221.87,
      "text": "염려해주는",
      "start": 221.419,
      "volume": 0.6043,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 222.035,
      "text": "건",
      "start": 221.915,
      "volume": 0.4026,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 222.696,
      "text": "고맙지만",
      "start": 222.095,
      "volume": 0.2946,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 222.996,
      "text": "이",
      "start": 222.936,
      "volume": 0.2763,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 223.477,
      "text": "늦은",
      "start": 223.176,
      "volume": 0.312,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 223.877,
      "text": "시간에...",
      "start": 223.537,
      "volume": 0.383,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 224.237,
      "text": "잠깐!",
      "start": 223.917,
      "volume": 0.5501,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 226.679,
      "text": "귀걸이가",
      "start": 226.299,
      "volume": 0.6409,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 227.06,
      "text": "한쪽",
      "start": 226.719,
      "volume": 0.3522,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 228.075,
      "text": "뿐이군요.",
      "start": 227.105,
      "volume": 0.2828,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 228.901,
      "text": "그것도",
      "start": 228.621,
      "volume": 0.4244,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 229.342,
      "text": "진주",
      "start": 229.081,
      "volume": 0.6268,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 229.802,
      "text": "귀걸이.",
      "start": 229.382,
      "volume": 0.3729,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 235.387,
      "text": "당장",
      "start": 235.127,
      "volume": 0.6573,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 235.487,
      "text": "그",
      "start": 235.407,
      "volume": 0.3381,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 235.627,
      "text": "총",
      "start": 235.527,
      "volume": 0.6907,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 235.887,
      "text": "치우...",
      "start": 235.687,
      "volume": 0.4354,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 239.81,
      "text": "지금",
      "start": 239.65,
      "volume": 0.6339,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 240.711,
      "text": "제정신입니까?",
      "start": 239.851,
      "volume": 0.6478,
      "speaker": "SPEAKER_07"
    },
    {
      "end": 242.032,
      "text": "물러서십시오.",
      "start": 241.031,
      "volume": 0.5527,
      "speaker": "SPEAKER_02"
    },
    {
      "end": 246.816,
      "text": "귀걸이",
      "start": 246.536,
      "volume": 0.6193,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 247.197,
      "text": "한쪽은...",
      "start": 246.856,
      "volume": 0.5017,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 249.163,
      "text": "여기에",
      "start": 248.583,
      "volume": 0.828,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 249.984,
      "text": "넣어놨어요.",
      "start": 249.223,
      "volume": 0.6137,
      "speaker": "SPEAKER_01"
    },
    {
      "end": 251.284,
      "text": "물어서십시오.",
      "start": 250.724,
      "volume": 0.653,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 255.966,
      "text": "제가",
      "start": 255.706,
      "volume": 0.912,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 259.566,
      "text": "확인하겠습니다.",
      "start": 256.066,
      "volume": 0.566,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 264.289,
      "text": "아니요.",
      "start": 263.969,
      "volume": 0.5507,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 267.51,
      "text": "내가",
      "start": 267.29,
      "volume": 0.7105,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 268.09,
      "text": "확인합니다.",
      "start": 267.55,
      "volume": 0.6856,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 271.092,
      "text": "총",
      "start": 270.891,
      "volume": 0.779,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 271.372,
      "text": "내리고",
      "start": 271.132,
      "volume": 0.6418,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 272.272,
      "text": "물러서세요.",
      "start": 271.432,
      "volume": 0.5835,
      "speaker": "SPEAKER_06"
    },
    {
      "end": 303.813,
      "text": "2층에",
      "start": 302.313,
      "volume": 0.1389,
      "speaker": "SPEAKER_03"
    },
    {
      "end": 313.081,
      "text": "계신가?",
      "start": 312.2,
      "volume": 0.6533,
      "speaker": "SPEAKER_08"
    },
    {
      "end": 315.483,
      "text": "저",
      "start": 314.822,
      "volume": 0.1433,
      "speaker": "SPEAKER_03"
    },
    {
      "end": 317.083,
      "text": "왔어요!",
      "start": 315.583,
      "volume": 0.0182,
      "speaker": "SPEAKER_03"
    },
    {
      "end": 321.067,
      "text": "빨리!",
      "start": 320.747,
      "volume": 0.0035,
      "speaker": "SPEAKER_03"
    },
    {
      "end": 323.187,
      "text": "움직이지",
      "start": 321.187,
      "volume": 0.0,
      "speaker": "SPEAKER_03"
    },
    {
      "end": 325.75,
      "text": "마!",
      "start": 325.13,
      "volume": 0.0053,
      "speaker": "SPEAKER_03"
    },
    {
      "end": 326.431,
      "text": "통역관님",
      "start": 325.811,
      "volume": 0.585,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 328.212,
      "text": "지금",
      "start": 327.932,
      "volume": 0.3907,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 329.333,
      "text": "우리를",
      "start": 329.033,
      "volume": 0.485,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 329.894,
      "text": "체포하러",
      "start": 329.433,
      "volume": 0.304,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 330.114,
      "text": "온",
      "start": 329.974,
      "volume": 0.2108,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 330.474,
      "text": "거예요?",
      "start": 330.154,
      "volume": 0.1944,
      "speaker": "SPEAKER_00"
    },
    {
      "end": 332.743,
