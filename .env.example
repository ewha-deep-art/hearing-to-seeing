# WhisperX server (STT + alignment + diarization). Both required.
# The containers reach a server on the same machine through host.docker.internal.
WHISPERX_API_KEY=
WHISPERX_API_URL=http://host.docker.internal:8000/whisperx

# Gemini API key (free tier is enough). When set, web jobs look up the work
# from the video title, search Wikipedia/Namu wiki for its characters, choose a
# subtitle colour for each and infer which speaker is which character — in
# parallel with STT — then check each utterance's speaker against the video,
# and file each clip under a genre. Without it nothing is fetched, colours are
# spread evenly and every clip goes under 기타.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project the web UI keeps its clip catalogue in (the `clips` table).
# Server-only secret key: Settings → API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Token the web UI asks for before deleting a clip. Unset, nobody can delete.
ADMIN_TOKEN=
