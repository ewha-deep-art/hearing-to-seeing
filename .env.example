# Remote WhisperX server (STT + alignment + diarization). Both required.
WHISPERX_API_KEY=
WHISPERX_API_URL=http://100.69.233.18:8000/whisperx

# Optional: paths to ffmpeg-family binaries that are not on PATH.
# Used by the volume step (PCM decode) and the preview renderer.
# H2S_FFPROBE is inferred from H2S_FFMPEG's directory when unset.
# H2S_FFMPEG=/usr/bin/ffmpeg
# H2S_FFPROBE=/usr/bin/ffprobe

# Gemini API key (free tier is enough). When set, web jobs look up the work
# from the video title, search Wikipedia/Namu wiki for its characters, choose a
# subtitle colour for each and infer which speaker is which character — in
# parallel with STT — then check each utterance's speaker against the video. Without it nothing is fetched and colours are spread evenly.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model used by the lookup (default: gemini-3.6-flash, ~30 s per call;
# gemini-3.5-flash-lite is ~10x faster and is the automatic fallback on 429/503).
# H2S_LLM_MODEL=gemini-3.5-flash-lite

# Optional: model for the video review — speakers by who is on screen and the
# disputed words between Whisper passes (default: gemini-3.5-flash). It has no
# fallback: on failure the review is skipped and the plain vote is kept. Its
# daily free-tier quota is separate from H2S_LLM_MODEL's (docs/STT_TUNING.md).
# H2S_REVIEW_MODEL=gemini-3.6-flash

# Optional: where the web UI keeps its video library (default: data/output/library).
# H2S_LIBRARY_DIR=data/output/library
