# Hugging Face access token.
# Required by the speaker-diarization step (WhisperX / pyannote); the gated
# pyannote models must also be accepted on huggingface.co with this account.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: paths to ffmpeg-family binaries that are not on PATH.
# Used by the volume step (PCM decode) and the preview renderer.
# H2S_FFPROBE is inferred from H2S_FFMPEG's directory when unset.
# H2S_FFMPEG=/usr/bin/ffmpeg
# H2S_FFPROBE=/usr/bin/ffprobe
