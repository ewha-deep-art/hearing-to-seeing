# Hugging Face access token.
# Required by the speaker-diarization step (WhisperX / pyannote); the gated
# pyannote models must also be accepted on huggingface.co with this account.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: paths to ffmpeg-family binaries that are not on PATH.
# Used by the volume step (PCM decode) and the preview renderer.
# H2S_FFPROBE is inferred from H2S_FFMPEG's directory when unset.
# H2S_FFMPEG=/usr/bin/ffmpeg
# H2S_FFPROBE=/usr/bin/ffprobe

# Gemini API key (free tier is enough). Required only by the --lookup step,
# which identifies the work from its title, searches the web for its
# characters, argues a subtitle colour for each and infers which speaker is
# which character. Nothing is fetched without --lookup.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model used by --lookup (default: gemini-3.6-flash, ~30 s per call).
# gemini-3.5-flash-lite is ~10x faster and fine for iterating; it is also the
# automatic fallback when the default model is over quota or overloaded.
# H2S_LLM_MODEL=gemini-3.5-flash-lite
# H2S_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: use Claude instead (needs `uv sync --extra claude` and ANTHROPIC_API_KEY).
# H2S_LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
